# Copier ce fichier en `.env` (à la racine) pour surcharger la configuration.
# Toutes les valeurs ont un défaut raisonnable pour le développement local.

# Adresse et port de l'API Fastify (le front Vite est sur 5173 et relaie /api vers ce port)
API_HOST=127.0.0.1
API_PORT=3000

# Chemin du fichier SQLite (relatif à la racine du projet)
DB_PATH=data/poryg.db

# Durée de vie d'une session (heures, glissante)
SESSION_TTL_HOURS=8

# development | production
# En production : cookie `Secure`, CSP stricte, et l'API sert le front compilé (client/dist)
NODE_ENV=development

# --- SSO Google (facultatif) -------------------------------------------------
# Sans ces deux valeurs, seule la connexion par mot de passe est proposée.
# Comment les obtenir : voir README.md, section « Activer la connexion Google ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit être déclarée à l'identique dans la console Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Signature des cookies techniques. Laissé vide, un secret aléatoire est tiré à
# chaque démarrage (suffisant en développement). À fixer en production.
COOKIE_SECRET=
