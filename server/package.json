{
  "name": "@poryg/server",
  "private": true,
  "version": "0.1.0",
  "description": "API Poryg'AI — Fastify + SQLite (node:sqlite), sessions cookie, RBAC, audit",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --import tsx --disable-warning=ExperimentalWarning src/server.ts",
    "db:migrate": "node --import tsx --disable-warning=ExperimentalWarning src/db/cli.ts migrate",
    "db:seed": "node --import tsx --disable-warning=ExperimentalWarning src/db/cli.ts seed",
    "db:reset": "node --import tsx --disable-warning=ExperimentalWarning src/db/cli.ts reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@poryg/shared": "*",
    "fastify": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
